# Optional ElevenLabs speech. Live audio/text leaves the site only when online.
# Requires speech_to_text and text_to_speech permissions. Blank key keeps text input available.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional OpenAI-compatible text parser, used only when offline mode is off.
# Online parsing sends the utterance and controlled vocabulary to this endpoint.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Parser and voice both check this before provider calls. Keep 1 for local-only.
EARSHOT_OFFLINE=1
