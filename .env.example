# Optional future online speech integration; unused by the Phase 2 scaffold.
ELEVENLABS_API_KEY=

# Optional OpenAI-compatible text parser, used only when offline mode is off.
# Online parsing sends the utterance and controlled vocabulary to this endpoint.
LLM_BASE_URL=https://api.studio.nebius.ai/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B

# Phase 6 parser checks this before constructing a client and before each call.
# Keep 1 for local-only parsing; voice integration comes in a later phase.
EARSHOT_OFFLINE=1
